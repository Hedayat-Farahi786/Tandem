# Values for the Phase 1 spikes. Copy to spikes/.env (git-ignored) or export them.

# SSH clone URL of a CodeCommit sandbox repo (spikes a, b, c). Seed an empty repo first:
#   pnpm spike:seed -- backend <url>
TANDEM_SPIKE_REPO_URL=

# Optional: AWS CLI profile and region for spike c (PR API). Without a profile the
# default credential chain is tried, then only the console-link fallback is checked.
TANDEM_SPIKE_AWS_PROFILE=
TANDEM_SPIKE_AWS_REGION=

# Optional: use the installed Copilot CLI instead of the SDK's bundled runtime.
COPILOT_CLI_PATH=
# Optional: model id for spike a (default: the runtime default).
TANDEM_SPIKE_MODEL=

# Optional, Jira spike only (skipped when empty). Cloud: base URL + email + API token.
# Data Center: base URL + personal access token, leave JIRA_EMAIL empty.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SPIKE_ISSUE=
JIRA_SPIKE_JQL=status = "Ready for AI"
