{
  "name": "@tandem/server",
  "version": "1.0.0",
  "private": true,
  "description": "Tandem's local HTTP server, event stream and CLI (tandem, tandem doctor).",
  "type": "module",
  "bin": {
    "tandem": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@tandem/adapters": "workspace:*",
    "@tandem/core": "workspace:*",
    "@tandem/shared": "workspace:*",
    "fastify": "5.12.8",
    "marked": "18.1.3",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.7",
    "@types/ws": "8.18.1"
  }
}
