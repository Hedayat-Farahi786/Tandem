{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "@tandem/shared": ["./packages/shared/src/index.ts"],
      "@tandem/core": ["./packages/core/src/index.ts"],
      "@tandem/core/testing": ["./packages/core/src/testing/index.ts"],
      "@tandem/adapters": ["./packages/adapters/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/test/**/*.ts", "vitest.config.ts"]
}
