# Tandem configuration. Every value is optional; defaults are shown.
# Copy to .env for development. Settings edited in the UI are stored in ~/.tandem/tandem.db;
# these environment variables override them. Secrets (Jira, GitHub tokens) are NOT set here:
# they live in the OS keychain and are entered in Settings.

# Where Tandem keeps its database, logs, mirrors and task folders.
TANDEM_HOME=~/.tandem
# Port on 127.0.0.1 (Tandem never listens on other interfaces).
TANDEM_PORT=4317
# fatal | error | warn | info | debug | trace | silent
TANDEM_LOG_LEVEL=info

# GitHub host that provides Copilot. Empty = github.com. For GitHub Enterprise Cloud with data
# residency, set your company host, for example mycompany.ghe.com.
COPILOT_GH_HOST=
# Use the installed Copilot CLI instead of the SDK's bundled runtime (rarely needed).
COPILOT_CLI_PATH=
# Model for build sessions (empty = runtime default) and for light steps (empty = cheapest enabled).
TANDEM_MODEL=
TANDEM_LIGHT_MODEL=
# Copilot budget: prompts per task and per day.
TANDEM_BUDGET_PER_TASK=15
TANDEM_BUDGET_PER_DAY=40

# AWS profile and region for CodeCommit (PR API and git over HTTPS). Empty = default chain.
TANDEM_AWS_PROFILE=
TANDEM_AWS_REGION=

# Limits.
TANDEM_MAX_CONCURRENT_BUILDS=1
TANDEM_BUILD_TIMEOUT_MIN=60

# Tests only.
# TANDEM_AGENT=scripted          use the deterministic agent (no Copilot)
# TANDEM_REAL=1                  run integration tests against real CodeCommit (no Copilot)
# TANDEM_REAL_REPO=codecommit::eu-central-1://<sandbox-repo>
# TANDEM_E2E_JIRA=1              run the Jira end-to-end tests (needs a Jira token in the keychain)
