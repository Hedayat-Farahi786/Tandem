# Tandem, the web app. Copy to .env to run it on one computer (development, or to try it).
# On a server, set these in the environment instead, secrets from your secret manager
# (docs/DEPLOYMENT.md lists every setting). Workspace settings edited in the app are stored
# per workspace; the values here only start them.

# ---- Sign-in: the GitHub App (docs/DEPLOYMENT.md section 1). Required.
# For one computer, its callback is http://localhost:4317/auth/github/callback.
TANDEM_GITHUB_CLIENT_ID=
TANDEM_GITHUB_CLIENT_SECRET=
# TANDEM_GITHUB_APP_SLUG=                          # the App's URL name, for the "Give Tandem access" link
# TANDEM_GITHUB_WEBHOOK_SECRET=                    # the App's webhook secret (pull request changes arrive at once)

# ---- Where Tandem runs.
TANDEM_PORT=4317
# The address people open. Default: http://localhost:<port>, listening on 127.0.0.1 only.
# TANDEM_PUBLIC_URL=https://app.example.com
# TANDEM_LISTEN_HOST=0.0.0.0                       # on a server, behind your load balancer (TLS ends there)
# Data: the directory, every workspace, logs. Default ~/.tandem.
# TANDEM_HOME=~/.tandem
# Seals stored tokens. On a server: openssl rand -base64 32, from your secret manager. On one
# computer (http://localhost), Tandem makes one in TANDEM_HOME/secret.key if this is empty.
# TANDEM_SECRET_KEY=
# fatal | error | warn | info | debug | trace | silent
TANDEM_LOG_LEVEL=info

# ---- Copilot runs on a member's own plan (Settings › Copilot).
# Default models when a chat or task has none picked ("Auto" in the model picker): build sessions
# (empty = Copilot's own choice) and light steps such as chat, spec and review (empty = cheapest).
TANDEM_MODEL=
TANDEM_LIGHT_MODEL=
# Copilot budget: starting values for a new workspace. Its owners change them in Settings › Budget.
TANDEM_BUDGET_PER_TASK=15
TANDEM_BUDGET_PER_DAY=40
# AI credits (1 credit = $0.01). A run that reaches a limit stops at once and the task waits.
TANDEM_CREDITS_PER_TASK=25
TANDEM_CREDITS_PER_DAY=75
# Builds per workspace, and how long one may take.
TANDEM_MAX_CONCURRENT_BUILDS=1
TANDEM_BUILD_TIMEOUT_MIN=60

# ---- Connections offered in the app (optional).
# "Connect Jira" with Atlassian's sign-in (docs/DEPLOYMENT.md, Jira); without it, Jira connects with a token.
# TANDEM_JIRA_CLIENT_ID=
# TANDEM_JIRA_CLIENT_SECRET=
# CodeCommit through roles in customers' AWS accounts (this server's role assumes them).
# TANDEM_AWS_ROLE_SOURCE=on
# TANDEM_AWS_TEMPLATE_URL=                         # the role template on S3, for CloudFormation's one-click link

# ---- Running it for real (docs/DEPLOYMENT.md).
# TANDEM_SANDBOX=on                                # builds run isolated; off only to try Tandem out
# TANDEM_SIGNUP=invite                             # invite-only sign-up; TANDEM_SIGNUP_ALLOW=login1,login2 lets these GitHub logins in too
# TANDEM_METRICS_TOKEN=                            # Prometheus scrapes /metrics with this bearer token
# TANDEM_TRUST_PROXY=1                             # proxies in front that add X-Forwarded-For
# TANDEM_LIMIT_WORKSPACES_PER_PERSON=10            # quotas (also _MEMBERS_PER_WORKSPACE=100, _INVITES_PER_DAY=50)
# TANDEM_CLI_PACKAGE=                              # the tandem command for company runners (set in the image)
# TANDEM_DATABASE_URL=postgres://…                 # several replicas: the shared directory in Postgres
# TANDEM_REPLICA_ID=tandem-0                       # several replicas: this replica's stable name (the pod's)
# TANDEM_REPLICA_URL=http://tandem-0.tandem:8080   # several replicas: where the others reach this one

# ---- Tests only.
# TANDEM_AGENT=scripted          use the deterministic agent (no Copilot)
# TANDEM_REAL_MODELS=1           with TANDEM_AGENT=scripted: list your real Copilot models in the picker (free, no prompts)
# TANDEM_REAL=1                  run integration tests against real CodeCommit (no Copilot)
# TANDEM_REAL_REPO=codecommit::eu-central-1://<sandbox-repo>
# TANDEM_E2E_JIRA=1              run the Jira end-to-end tests against a real Jira (TANDEM_E2E_JIRA_URL, _EMAIL, _TOKEN, _ISSUE)
# Browser tests (pnpm test:e2e):
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=  an existing Chromium instead of `npx playwright install chromium`
# TANDEM_SCREENSHOTS=1           save light and dark screenshots to docs/evidence/phase-3/
# TANDEM_E2E_DIR=                work folder for the test server (default: a new temp folder)
# TANDEM_E2E_PORT=4399
# TANDEM_TEST_REMOTE_ROOT=       serve CodeCommit repos from local copies in <dir>/<name>.git (any agent)
# TANDEM_E2E_REAL=1              run the flows on real CodeCommit sandbox repos, through a company runner on this computer (with TANDEM_AWS_PROFILE)
# TANDEM_E2E_COPILOT=1           run the live Copilot flows through a company runner on this computer: SPENDS AI CREDITS (capped; TANDEM_E2E_MODEL)
# TANDEM_E2E_KEEP=1              keep the flows' work folder afterwards
